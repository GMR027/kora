{
  "name": "kora",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "dev:demo": "node scripts/copy-pdfjs.mjs && vite",
    "predev": "node scripts/copy-pdfjs.mjs && pnpm build:helper",
    "build": "tsc --noEmit && vite build",
    "build:helper": "cargo build -p kora-neutts && node scripts/copy-helper.mjs",
    "build:helper:release": "cargo build --release -p kora-neutts && node scripts/copy-helper.mjs --release",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "node scripts/tauri.mjs",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "android:build:release": "tauri android build --apk",
    "android:build:debug": "tauri android build --apk --debug",
    "build:linux": "pnpm build:helper:release && pnpm tauri build --bundles deb"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "pdfjs-dist": "^6.5.438",
    "quill": "^2.0.3",
    "svelte": "^5.58.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.12",
    "esbuild": "^0.28",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
